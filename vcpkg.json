{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "mfplay",
  "version-semver": "0.1.0",
  "builtin-baseline": "93ad765c7b66ab9ce97469ec23a90b15c3a14ee5",
  "dependencies": [
    "catch2",
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": ["avcodec"]
    },
    {
      "name": "imgui",
      "features": ["dx12-binding", "win32-binding"]
    },
    "json-c",
    "libevent",
    "miniupnpc",
    "nlohmann-json",
    "openssl",
    "opus",
    "sdl3",
    "spdlog",
    {
      "name": "pkgconf",
      "host": true
    },
    {
      "name": "protobuf",
      "host": true
    }
  ]
}
